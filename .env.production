# Production Environment Variables
# Copy this file to .env and fill in your production values

# Application Settings
ENVIRONMENT=production
DEBUG=False
PORT=8000

# Database Configuration
# For PostgreSQL (Recommended for production):
DATABASE_URL=postgresql://username:password@host:5432/landing_pages
# For SQLite (Development only):
# DATABASE_URL=sqlite:///./landing_pages.db

# AI Provider Configuration
# Use 'gemini' (FREE) or 'openai'
AI_PROVIDER=gemini

# Gemini API (Primary - FREE)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Image Integration (Optional)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Security Settings
SECRET_KEY=your_super_secret_key_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings (Frontend URLs)
CORS_ORIGINS=https://your-frontend-domain.com,https://your-app.netlify.app

# PostgreSQL Settings (if using docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=landing_pages

# Redis Settings (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=30

# File Storage
MAX_UPLOAD_SIZE=10485760  # 10MB
STORAGE_PATH=./generated_pages

# Email Settings (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@yourdomain.com
